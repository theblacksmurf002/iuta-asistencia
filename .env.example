# =============================================================================
# IUTA ASISTENCIA INTELIGENTE - VARIABLES DE ENTORNO
# =============================================================================

# URL base de la aplicación (usada por NextAuth para redirecciones y callbacks)
NEXTAUTH_URL=http://localhost:3000

# Secreto para cifrado de tokens JWT y cookies de sesión (genera uno con: openssl rand -base64 32)
NEXTAUTH_SECRET=iuta_asistencia_super_secure_jwt_secret_key_2026_x89a

# Credenciales de Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
